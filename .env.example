# Shared Postgres connection. Heroku sets DATABASE_URL automatically.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Discord user authorization is used only to fetch source history. The webhook
# posts temporary link checks to a private channel; it is not a bot token.
USER_AUTH=
DISCORD_CONTENT_CHANNEL_ID=124767749099618304
DISCORD_CONTENT_GUILD_ID=124767749099618304
DISCORD_DEAD_LINK_WEBHOOK_URL=
DISCORD_REVIVAL_WEBHOOK_URL=

# Feed eligibility and deployment mode.
MIN_CONTENT_AGE=18 year
RUN_BACKGROUND_TASKS=false

# Anonymous Imgur API client ID for revival uploads.
IMGUR_CLIENT_ID=
